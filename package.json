{
  "name": "@hawk.so/nextjs",
  "version": "1.0.0",
  "description": "Next.js integration for sending releases with source maps to Hawk",
  "keywords": [
    "hawk",
    "nextjs",
    "turbopack",
    "source maps",
    "error tracking"
  ],
  "repository": "https://github.com/codex-team/hawk.nextjs.git",
  "author": "CodeX <team@codex.so>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "global.d.ts"
  ],
  "workspaces": [
    "example"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "e2e": "yarn build && node scripts/e2e.mjs",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "next": ">=15.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-codex": "^2.0.3",
    "next": "^16.4.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
